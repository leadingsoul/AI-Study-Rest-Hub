<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai_study_rest_hub_server.mapper.GuessTopicMapper">

    <resultMap id="BaseResultMap" type="com.ai_study_rest_hub_server.entity.GuessTopic">
            <id property="id" column="id" />
            <result property="topicName" column="topic_name" />
            <result property="topicDescription" column="topic_description" />
            <result property="categoryId" column="category_id" />
            <result property="recordCount" column="record_count" />
            <result property="difficulty" column="difficulty" />
            <result property="target" column="target" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        id,topic_name,topic_description,category_id,record_count,difficulty,
        target,create_time,update_time,is_deleted
    </sql>

    <select id="getTopicList" resultMap="BaseResultMap">
        SELECT gt.*, gtc.name as category_name
        FROM guess_topics gt
        LEFT JOIN guess_categories gtc ON gt.category_id = gtc.id
        WHERE gt.is_deleted = 0
        <!-- 按分类ID筛选 -->
        <if test="categoryId != null">
            AND gt.category_id = #{categoryId}
        </if>
        <!-- 按难度筛选 -->
        <if test="difficulty != null and difficulty != ''">
            AND gt.difficulty = #{difficulty}
        </if>
        <!-- 按关键词模糊搜索（标题/内容/答案） -->
        <if test="keyword != null and keyword != ''">
            AND (gt.topic_name LIKE concat('%', #{keyword}, '%')
            OR gt.topic_description LIKE concat('%', #{keyword}, '%')
            OR gt.target LIKE concat('%', #{keyword}, '%'))
        </if>
        <!-- 排序 -->
        ORDER BY gt.create_time DESC
    </select>

</mapper>
