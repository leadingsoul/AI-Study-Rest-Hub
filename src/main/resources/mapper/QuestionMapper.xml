<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai_study_rest_hub_server.mapper.QuestionMapper">

    <resultMap id="BaseResultMap" type="com.ai_study_rest_hub_server.entity.Question">
            <id property="id" column="id" />
            <result property="title" column="title" />
            <result property="type" column="type" />
            <result property="multi" column="multi" />
            <result property="categoryId" column="category_id" />
            <result property="difficulty" column="difficulty" />
            <result property="score" column="score" />
            <result property="analysis" column="analysis" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <resultMap id="detailQuestionMap" type="com.ai_study_rest_hub_server.entity.Question">
        <!-- 题目基础字段 -->
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="type" property="type"/>
        <result column="multi" property="multi"/>
        <result column="category_id" property="categoryId"/>
        <result column="difficulty" property="difficulty"/>
        <result column="score" property="score"/>
        <result column="analysis" property="analysis"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="paper_score" property="paperScore"/>

        <!-- 题目答案（一对一） -->
        <association property="answer" javaType="com.ai_study_rest_hub_server.entity.QuestionAnswer">
            <id column="qas_id" property="id"/>
            <result column="question_id" property="questionId"/>
            <result column="answer" property="answer"/>
            <result column="keywords" property="keywords"/>
            <result column="qas_create_time" property="createTime"/>
            <result column="qas_update_time" property="updateTime"/>
        </association>

        <!-- 题目选项（一对多） -->
        <collection property="choices" ofType="com.ai_study_rest_hub_server.entity.QuestionChoice">
            <id column="qcs_id" property="id"/>
            <result column="qcs_question_id" property="questionId"/>
            <result column="content" property="content"/>
            <result column="is_correct" property="isCorrect"/>
            <result column="sort" property="sort"/>
            <result column="qcs_create_time" property="createTime"/>
            <result column="qcs_update_time" property="updateTime"/>
        </collection>
    </resultMap>

    <sql id="Base_Column_List">
        id,title,type,multi,category_id,difficulty,
        score,analysis,create_time,update_time,is_deleted
    </sql>

    <select id="queryQuestionListByPageId" resultMap="detailQuestionMap">
        select
        qs.id,
        CONVERT(qs.title USING utf8) as title, -- 题干BLOB转字符串
        qs.type,
        qs.multi,
        qs.category_id,
        qs.difficulty,
        qs.score,
        CONVERT(qs.analysis USING utf8) as analysis, -- 解析BLOB转字符串
        qs.create_time,
        qs.update_time,
        qs.is_deleted,
        -- 答案表字段（BLOB转字符串）
        qas.id qas_id,
        qas.question_id,
        CONVERT(qas.answer USING utf8) as answer, -- 标准答案BLOB转字符串
        CONVERT(qas.keywords USING utf8) as keywords, -- 关键词BLOB转字符串
        qas.create_time qas_create_time,
        qas.update_time qas_update_time,
        -- 选项表字段（BLOB转字符串）
        qcs.id qcs_id,
        qcs.question_id qcs_question_id,
        CONVERT(qcs.content USING utf8) as content, -- 选项内容BLOB转字符串
        qcs.is_correct,
        qcs.sort,
        qcs.create_time qcs_create_time,
        qcs.update_time qcs_update_time,
        -- 试卷-题目关联表分值
        pq.score  paper_score
        from paper_question pq
        join questions qs on pq.question_id = qs.id
        join question_answers qas on qs.id = qas.question_id
        left join question_choices qcs on qs.id = qcs.question_id and qcs.is_deleted  = 0
        <where>
            pq.is_deleted = 0
            and qs.is_deleted = 0
            and qas.is_deleted = 0
            and pq.paper_id = #{paperId}
        </where>
        order by qcs.sort asc
    </select>
</mapper>
